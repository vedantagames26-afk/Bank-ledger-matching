# Optional Gemini explanation, disabled unless both values are configured.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_REQUEST_LIMIT=10
# Optional read-only live fetching and signed webhook receipts.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional previous secret during documented webhook retries after rotation.
RAZORPAY_WEBHOOK_PREVIOUS_SECRET=
# Optional local token. Set the same token in the dashboard's session settings.
RECON_ACCESS_TOKEN=
# RECON_RUNTIME=/absolute/private/runtime/path
